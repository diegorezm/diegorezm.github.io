---
import { Square } from "lucide-astro";

interface Props {
  title?: string;
}

const { title } = Astro.props;
---

<div class="card border border-vintage-border rounded-vintage overflow-hidden shadow-sm">
  {title && (
    <div class="pinstripe flex items-center gap-2 px-3 py-2 border-b border-vintage-border bg-vintage-surface">
      <Square size={12} strokeWidth={1.5} aria-hidden="true" />
      <span class="font-vintage-display text-xs bg-white px-2 py-0.5 border border-vintage-border rounded-vintage-sm">
        {title}
      </span>
    </div>
  )}

  <div class="p-5">
    <slot />
  </div>
</div>
