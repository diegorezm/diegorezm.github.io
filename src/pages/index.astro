---
import Layout from "../components/root-layout.astro";
import Card from "../components/card.astro";
import SectionTitle from "../components/section-title.astro";
import { ArrowUpRight, Check, FileText, FolderArchive, Mail, Terminal } from "lucide-astro";
---

<Layout title="Vintage Theme" description="A vintage-inspired interface and component portfolio.">
  <main class="max-w-3xl mx-auto space-y-8 px-6 py-12">

    <!-- Hero -->
    <div class="overflow-hidden rounded-vintage border border-vintage-border shadow-sm">
      <div class="pinstripe flex items-center gap-2 border-b border-vintage-border bg-vintage-surface px-3 py-2">
        <Terminal size={14} strokeWidth={1.5} aria-hidden="true" />

        <span class="rounded-vintage-sm border border-vintage-border bg-white px-2 py-0.5 font-vintage-display text-xs">
          system.status
        </span>
      </div>

      <div class="card p-10">
        <p class="mb-3 text-xs uppercase tracking-wide text-vintage-muted">
          v1.0 — booted successfully
        </p>

        <h1 class="mb-4 font-vintage-display text-3xl leading-tight md:text-4xl">
          A theme that remembers<br />
          where computers came from.
        </h1>

        <p class="mb-7 max-w-md leading-relaxed text-gray-700">
          Thin borders. High contrast. Bitmap-inspired type, softened for a modern
          screen. No gradients, no shadows pretending to be light sources — just
          structure.
        </p>

        <div class="flex gap-3">
          <button class="btn btn-primary">
            Get started <ArrowUpRight size={15} aria-hidden="true" />
          </button>

          <button class="btn btn-secondary">
            View docs <FileText size={15} aria-hidden="true" />
          </button>
        </div>
      </div>
    </div>

    <!-- Components -->
    <div class="grid grid-cols-1 gap-5 md:grid-cols-2">

      <Card title="buttons.app">
        <SectionTitle>Actions</SectionTitle>

        <div class="flex flex-wrap gap-2">
          <button class="btn btn-primary">
            Primary <Check size={15} aria-hidden="true" />
          </button>

          <button class="btn btn-secondary">
            Secondary
          </button>

          <button
            disabled
            class="btn border-vintage-muted-light bg-vintage-surface text-vintage-muted cursor-not-allowed"
          >
            Disabled
          </button>
        </div>
      </Card>

      <Card title="form.app">
        <SectionTitle>Input</SectionTitle>

        <label class="mb-1.5 block text-sm font-bold">
          Name
        </label>

        <input
          type="text"
          placeholder="Type here..."
          class="input mb-4"
        />

        <label class="mb-1.5 block text-sm font-bold">
          Message
        </label>

        <textarea
          rows="3"
          placeholder="Say something..."
          class="input"
        />
      </Card>

      <Card title="notes.app">
        <SectionTitle>Recent files</SectionTitle>

        <ul class="text-sm">
          <li class="flex items-center gap-2 border-b border-vintage-muted-light py-2">
            <FileText size={14} strokeWidth={1.5} aria-hidden="true" />
            readme.txt
          </li>

          <li class="flex items-center gap-2 border-b border-vintage-muted-light py-2">
            <Mail size={14} strokeWidth={1.5} aria-hidden="true" />
            notes.doc
          </li>

          <li class="flex items-center gap-2 py-2">
            <FolderArchive size={14} strokeWidth={1.5} aria-hidden="true" />
            archive.zip
          </li>
        </ul>
      </Card>

    </div>

    <footer class="pt-6 text-center text-xs text-vintage-muted">
      Built with the vintage theme — thin lines, real contrast.
    </footer>

  </main>
</Layout>
